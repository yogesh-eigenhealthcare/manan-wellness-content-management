{
  "name": "manan-wellness-content-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" npx -y firebase-tools@13.35.1 emulators:exec --only firestore \"npx vitest run --config vitest.rules.config.ts\"",
    "seed:managers": "node scripts/seed-managers.mjs",
    "import:sheet": "npx tsx scripts/import-sheet.ts",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" npx -y firebase-tools@13.35.1 emulators:start --only auth,firestore"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "firebase-admin": "^13.4.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
  }
}
